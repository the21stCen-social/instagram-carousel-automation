# Copy to .env for local testing (NEVER commit the real .env).
# For the scheduled GitHub run, add the two secrets below under
# Settings -> Secrets and variables -> Actions. Paste each key on its own.

# Buffer API key: https://publish.buffer.com/settings/api   (secret)
BUFFER_API_KEY=
# Google AI Studio key: https://aistudio.google.com/apikey  (secret)
GEMINI_API_KEY=

# Optional ------------------------------------------------------------------
# Name and handle printed on the text card of every slide.
# CARD_NAME=the21stCen
# CARD_HANDLE=@the21stCen
# Set to 0 to drop the "Follow @handle ..." line on the last slide.
# CARD_FOOTER=1
# Gemini model (default gemini-3.1-flash-lite, fallback gemini-3.8-flash) and an optional second model for 503 spikes.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=
# Pin the Instagram channel if you connect more than one; only needed with several Buffer organizations:
# BUFFER_CHANNEL_INSTAGRAM=
# BUFFER_ORG_ID=
# Own carousels allowed to wait in the queue (default 1), slides per carousel (max 7).
# QUEUE_TARGET=1
# MAX_SLIDES=7
# Buffer post type for multi-image posts (default "post"; try "carousel" if Buffer rejects it).
# INSTAGRAM_POST_TYPE=post

# Set to 1 to draft and render WITHOUT saving, uploading or queueing anything.
DRY_RUN=1
